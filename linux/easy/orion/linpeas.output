server {
    listen 80;
    server_name localhost;
    root /var/www/html/craft/web;
    index index.php;
    charset utf-8;
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }
    location ~ /\.(ht|git) {
        deny all;
    }
    if ($host != orion.htb) {
        rewrite ^ http://orion.htb/;
    }
}



