    <h1 id="header">Sign in to Windows Admin Center</h1>
    <div id="formError" role="alert"></div>
    <fieldset id="loginForm" aria-labelledby="header">
        <input type="hidden" name="csrf" id="csrf" value="b3a28a0a32464393aeeee2a742e60595" />
        <label for="username">Username</label>
        <input type="text" name="username" id="username" required autofocus />
        <label for="password">Password</label>
        <input type="password" name="password" id="password" required />
        <button id="submit">Sign In</button>
    </fieldset>
    <script>
        var csrfInput = document.getElementById('csrf');
        var usernameInput = document.getElementById('username');
        var passwordInput = document.getElementById('password');
        var formError = document.getElementById('formError');
        var form = document.getElementById('loginForm');
        var submitButton = document.getElementById('submit');
        var refresh = false;

        var params = new URLSearchParams(window.location.search);
        var theme = localStorage.getItem("msft.sme.shell-assetManager-theme");
        if (params.has("theme")) {
            if (params.get("theme") === 'dark') {
                theme = "dark"
            } else {
                theme = "light"
            }

            localStorage.setItem("msft.sme.shell-assetManager-theme", theme);
        }

        if (!theme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            theme = "dark"
            localStorage.setItem("msft.sme.shell-assetManager-theme", theme);
        }

        if (theme === 'dark') {
            document.body.style.setProperty("--body-color", "#fff");
            document.body.style.setProperty("--body-background-color", "#262626");
            document.body.style.setProperty("--input-color", "#fff");
            document.body.style.setProperty("--input-background-color", "#333");
            document.body.style.setProperty("--input-border-color", "#666");

            // no changes
            // --input-hover-border-color: #000;
            // --input-focus-border-color: #0078d4;
            // --input-focus-box-shadow-color: #0078d4;

            document.body.style.setProperty("--button-color", "#000");
            document.body.style.setProperty("--button-background-color", "#66a4d4");
            document.body.style.setProperty("--button-border-color", "#66a4d4");
            document.body.style.setProperty("--button-hover-background-color", "#4d95cd");
            document.body.style.setProperty("--button-hover-border-color", "#4d95cd");
            document.body.style.setProperty("--button-disabled-color", "#b3b3b3");
            document.body.style.setProperty("--button-disabled-background-color", "#333");

            // no changes
            // --button-active-background-color: #005a9e;
            // --button-active-border-color: #005a9e;
            // --button-disabled-border-color: #0000;

            document.body.style.setProperty("--button-focus-outline-color", "#000");

            // no changes
            // --form-error-color: #E81123;
            // --form-progress-color: #0067B8;
        }

        var search = new URLSearchParams();
        for (var item of ["l", "theme"]) {
            if (params.has(item)) {
                search.append(item, params.get(item));
            }
        }

        var redirect = null;
        if (params.has("redirect")) {
            redirect = decodeURI(params.get("redirect"));
        }

        var hadError = params.has("e");

        var submitCredentials = (event) => {
            if (refresh) {
                loadPage(redirect, search, "");
                return;
            }

            event.stopPropagation();
            event.preventDefault();
            var username = usernameInput.value;
            var password = passwordInput.value;
            if (!username || !password || username.length == 0 || password.length == 0) {
                return;
            }

            formError.innerText = 'Signing in...';
            usernameInput.disabled = true;
            passwordInput.disabled = true;
            submitButton.disabled = true;
            formError.className = 'progress';
            var keyUrl = window.location.origin + '/api/user/key';
            var loginUrl = window.location.origin + '/api/user/login';

            var csrf = csrfInput.value;
            fetch(
                keyUrl,
                {
                    method: 'POST',
                    headers: { 'Content-type': 'application/json' },
                    body: JSON.stringify({ csrf }),
                })
                .then(response => response.json())
                .then(response => {
                    var jwk = response.jwk;
                    var data = JSON.stringify({ username, password, csrf });
                    return encrypt(jwk, data);
                })
                .then(packet => fetch(
                    loginUrl,
                    {
                        method: 'POST',
                        headers: { 'Content-type': 'application/json' },
                        body: JSON.stringify({ packet, csrf }),
                    })
                )
                .then(response => {
                    if (response.status === 200) {
                        loadPage(redirect, search, false);
                        return;
                    }

                    loadPage(redirect, search, true);
                })
                .catch(error => {
                    loadPage(redirect, search, true);
                });
        };

        submitButton.addEventListener('click', event => submitCredentials(event));
        form.addEventListener('keydown', event => { if (event.keyCode === 13) { submitCredentials(event); } });
        setTimeout(() => {
            if (refresh) {
                return;
            }

            refresh = true;
            var loginForm = document.getElementById("loginForm");
            loginForm.firstElementChild.remove();
            loginForm.firstElementChild.remove();
            loginForm.firstElementChild.remove();
            loginForm.firstElementChild.remove();
            loginForm.firstElementChild.remove();
            loginForm.firstElementChild.innerText = "Refresh";
            formError.innerText = 'Login timed out. Please click Refresh button to relogin.';
            formError.className = 'error';
        },
            10 * 60 * 1000);

        function loadPage(redirect, search, errored) {
            var target = new URL(window.location.origin);
            if (redirect) {
                if (errored) {
                    search.append("redirect", encodeURI(redirect));
                } else {
                    target = new URL(redirect);
                    search.append("gatewayUrl", encodeURI(window.location.origin));
                }
            }

            if (errored) {
                search.append("e", "_");
            }

            if (search.size > 0) {
                target.search = search;
            }

            window.location.replace(target);
        }

        function displayError() {
            usernameInput.disabled = false;
            passwordInput.disabled = false;
            submitButton.disabled = false;
            formError.innerText = 'Access denied. Please verify that the username and password are correct.';
            formError.className = 'error';
            passwordInput.focus();
            passwordInput.select();
        }

        if (hadError) {
            displayError();
        }

        function encrypt(jwk, data) {
            if (jwk == null || data == null) {
                return Promise.reject("missing data");
            }

            const root = window;
            if (!!root.msCrypto && root.msCrypto.subtle) {
                return Promise.reject("not supported");
            }

            if (!root.crypto) {
                return Promise.reject("not supported");
            }

            let subtle = root.crypto.subtle;
            if (subtle) {
                return encryptRsaWebAPI(subtle, jwk, data);
            }

            subtle = root.crypto.webkitSubtle;
            if (subtle) {
                const jwkString = JSON.stringify(jwk);
                const jwkArray = toArrayBufferView(jwkString);
                return encryptRsaWebAPI(subtle, jwkArray, data);
            }

            return Promise.reject("unknown");
        }

        function encryptRsaWebAPI(subtle, jwkObject, data) {
            const algRsaOaepSha1Key = { name: 'RSA-OAEP', hash: { name: 'SHA-256' } };
            const array = toUtf8ArrayBuffer(data);
            return subtle.importKey('jwk', jwkObject, algRsaOaepSha1Key, false, ['encrypt'])
                .then(publicKey => subtle.encrypt(algRsaOaepSha1Key, publicKey, array))
                .then(result => createBase64(result));
        }

        function toUtf8ArrayBuffer(data) {
            const utf8 = utf8Encode(data);
            return toArrayBuffer(utf8);
        }

        function utf8Encode(data) {
            return unescape(encodeURIComponent(data));
        }

        function toArrayBuffer(data) {
            const buffer = new ArrayBuffer(data.length);
            const view = new Uint8Array(buffer);
            for (let i = 0; i < buffer.byteLength; i++) {
                view[i] = data.charCodeAt(i);
            }

            return buffer;
        }

        function createBase64(arraybuffer) {
            var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
            var lookup = new Uint8Array(256);
            for (var i = 0; i < chars.length; i++) {
                lookup[chars.charCodeAt(i)] = i;
            }

            var bytes = new Uint8Array(arraybuffer), i, len = bytes.length, base64 = "";
            for (i = 0; i < len; i += 3) {
                base64 += chars[bytes[i] >> 2];
                base64 += chars[((bytes[i] & 3) << 4) | (bytes[i + 1] >> 4)];
                base64 += chars[((bytes[i + 1] & 15) << 2) | (bytes[i + 2] >> 6)];
                base64 += chars[bytes[i + 2] & 63];
            }

            if ((len % 3) === 2) {
                base64 = base64.substring(0, base64.length - 1) + "=";
            } else if (len % 3 === 1) {
                base64 = base64.substring(0, base64.length - 2) + "==";
            }

            return base64;
        }
