    <meta charset="utf-8">
    <link rel="icon" type="image/x-icon" href="favicon.ico?v=1.0.0">
    <title>Sign in - Windows Admin Center</title>
    <style>
        :root {
            --body-color: #000;
            --body-background-color: #fff;
            --input-color: #323130;
            --input-background-color: #fff;
            --input-border-color: #8a8886;
            --input-hover-border-color: #000;
            --input-focus-border-color: #0078d4;
            --input-focus-box-shadow-color: #0078d4;
            --button-color: #fff;
            --button-background-color: #0078d4;
            --button-border-color: #0078d4;
            --button-hover-background-color: #106ebe;
            --button-hover-border-color: #106ebe;
            --button-active-background-color: #005a9e;
            --button-active-border-color: #005a9e;
            --button-disabled-color: #999;
            --button-disabled-background-color: #f2f2f2;
            --button-disabled-border-color: #0000;
            --button-focus-outline-color: #fff;
            --form-error-color: #E81123;
            --form-progress-color: #0067B8;
        }

        body {
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            right: 0;
            color: var(--body-color);
            background: var(--body-background-color);
            display: flex;
            flex-wrap: nowrap;
            flex-direction: column;
            align-content: center;
            align-items: center;
            justify-content: flex-start;
        }

        * {
            box-sizing: border-box;
            margin: 0 0 0 0;
            padding: 0 0 0 0;
            font-size: 15px;
            line-height: 25px;
            vertical-align: baseline;
            text-align: center;
            font-family: 'Segoe UI Semibold', "Helvetica Neue", Helvetica, Arial, sans-serif;
            font-weight: 500;
            font-style: normal;
            letter-spacing: 0;
            font-variant: normal;
            font-weight: normal;
            text-rendering: auto;
            -webkit-font-smoothing: antialiased;
        }

        #spacer {
            height: 20vh;
            min-height: 25px;
            max-height: 120px;
        }

        #mssymbol {
            margin-bottom: 16px;
            width: 150px;
        }

        #logo {
            margin-bottom: 16px;
            width: 150px;
        }

        #header {
            font-size: 20px;
            line-height: 22px;
            margin-bottom: 20px;
            max-width: 400px;
        }

        #loginForm {
            border: none;
            width: 240px;
            flex-wrap: nowrap;
            flex-direction: column;
            align-content: center;
            align-items: center;
            justify-content: center;
        }

        #loginForm label {
            font-size: 13px;
            display: block;
            width: 100%;
            margin-bottom: 2px;
            text-align: left;
        }

        #loginForm input {
            padding: 2px 8px;
            line-height: 28px;
            display: block;
            width: 100%;
            margin-bottom: 8px;
            text-align: left;
            font-family: 'Segoe UI', "Helvetica Neue", Helvetica, Arial, sans-serif;
            color: var(--input-color);
            background-color: var(--input-background-color);
            border-color: var(--input-border-color);
            outline: none;
            border-width: 1px;
            box-shadow: none;
        }

        #loginForm input:hover {
            border-color: var(--input-hover-border-color);
        }

        #loginForm input:focus {
            border-color: var(--input-focus-border-color);
            box-shadow: inset 0 0 0 1px var(--input-focus-box-shadow-color);
        }

        #loginForm button {
            display: block;
            line-height: 31px;
            width: 50%;
            margin: 30px 0px 0px 60px;
            color: var(--button-color);
            background-color: var(--button-background-color);
            border-color: var(--button-border-color);
            outline: none;
            box-shadow: none;
            border-width: 1px;
        }

        #loginForm button:hover {
            background-color: var(--button-hover-background-color);
            border-color: var(--button-hover-border-color);
        }

        #loginForm button:active {
            background-color: var(--button-active-background-color);
            border-color: var(--button-active-border-color);
        }

        #loginForm button:focus {
            outline: solid;
            outline-width: 1px;
            outline-offset: -3px;
            outline-color: var(--button-focus-outline-color);
        }

        #loginForm button:disabled {
            color: var(--button-disabled-color);
            background-color: var(--button-disabled-background-color);
            border-color: var(--button-disabled-border-color);
        }

        #formError {
            display: none;
        }

        #formError.error {
            display: block;
            color: var(--form-error-color);
            margin-bottom: 20px;
        }

        #formError.progress {
            display: block;
            color: var(--form-progress-color);
            margin-bottom: 20px;
        }
    </style>
</head>

