type: txt
help: Number of times the expired TTL of a record is extended by 30
			seconds when serving stale (default: 0)
val_help: u32:0-65535; Number of times to extend the TTL
syntax:expression: exec "${vyos_libexec_dir}/validate-value  --exec \"${vyos_validators_dir}/numeric --range 0-65535\"  --value \'$VAR(@)\'"; "Invalid value"
