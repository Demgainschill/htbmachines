type: txt
help: Policy for IPv4 source validation by reversed path, as specified
			in RFC3704 (default: disable)
val_help: strict; Enable IPv4 Strict Reverse Path Forwarding as defined in RFC3704
val_help: loose; Enable IPv4 Loose Reverse Path Forwarding as defined in RFC3704
val_help: disable; No IPv4 source validation (default)
allowed: echo "strict loose disable"
syntax:expression: exec "${vyos_libexec_dir}/validate-value --regex \'(strict|loose|disable)\'   --value \'$VAR(@)\'"; "Invalid value"
