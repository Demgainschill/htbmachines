type: txt
help: Default client IPv6 pool name
val_help: txt; Default IPv6 pool
allowed: /bin/cli-shell-api listNodes ${COMP_WORDS[@]:1:${#COMP_WORDS[@]}-3} client-ipv6-pool
syntax:expression: exec "${vyos_libexec_dir}/validate-value --regex \'[-_a-zA-Z0-9][\\w\\-\\.\\+]*\'   --value \'$VAR(@)\'"; "Invalid value"
