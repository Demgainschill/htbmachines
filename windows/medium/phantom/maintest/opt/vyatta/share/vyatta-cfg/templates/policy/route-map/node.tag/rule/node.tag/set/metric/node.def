type: txt
help: Destination routing protocol metric
val_help: <+/-metric>; Add or subtract metric
val_help: u32:0-4294967295; Metric value
val_help: <+/-rtt>; Add or subtract round trip time
val_help: <rtt>; Round trip time
syntax:expression: exec "${vyos_libexec_dir}/validate-value --regex \'^[+|-]?rtt$\' --exec \"${vyos_validators_dir}/numeric --relative --\" --exec \"${vyos_validators_dir}/numeric --range 0-4294967295\"  --value \'$VAR(@)\'"; "Invalid value"
