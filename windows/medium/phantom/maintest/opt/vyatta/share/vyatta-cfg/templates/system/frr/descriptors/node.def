type: txt
help: Number of open file descriptors a process is allowed to use
			(default: 1024)
val_help: u32:1024-8192; Number of file descriptors
syntax:expression: exec "${vyos_libexec_dir}/validate-value  --exec \"${vyos_validators_dir}/numeric --range 1024-8192\"  --value \'$VAR(@)\'"; "Port number must be in range 1024 to 8192"
