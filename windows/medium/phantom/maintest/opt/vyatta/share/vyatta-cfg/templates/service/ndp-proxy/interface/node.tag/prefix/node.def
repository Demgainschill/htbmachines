tag:
type: txt
help: Prefix target addresses are matched against
val_help: ipv6net; IPv6 network prefix
val_help: ipv6; IPv6 address
syntax:expression: exec "${vyos_libexec_dir}/validate-value  --exec \"${vyos_validators_dir}/ipv6-prefix \" --exec \"${vyos_validators_dir}/ipv6-address \"  --value \'$VAR(@)\'"; "Invalid value"
