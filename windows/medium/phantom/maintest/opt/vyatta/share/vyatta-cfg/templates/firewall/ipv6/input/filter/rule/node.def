tag:
type: txt
help: IPv6 Firewall input filter rule number
val_help: u32:1-999999; Number for this firewall rule
syntax:expression: exec "${vyos_libexec_dir}/validate-value  --exec \"${vyos_validators_dir}/numeric --range 1-999999\"  --value \'$VAR(@)\'"; "Firewall rule number must be between 1 and 999999"
