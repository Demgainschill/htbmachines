type: txt
help: Leap second behavior (default: timezone)
val_help: ignore; No correction is applied to the clock for the leap second
val_help: smear; Correct served time slowly be slewing instead of stepping
val_help: system; Kernel steps the system clock forward or backward
val_help: timezone; Use UTC timezone database to determine when will the next leap second occur (default)
allowed: echo "ignore smear system timezone"
syntax:expression: exec "${vyos_libexec_dir}/validate-value --regex \'(ignore|smear|system|timezone)\'   --value \'$VAR(@)\'"; "Invalid value"
