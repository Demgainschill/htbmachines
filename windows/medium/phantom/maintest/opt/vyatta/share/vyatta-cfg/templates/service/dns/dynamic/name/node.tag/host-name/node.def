multi:
type: txt
help: Hostname to register with Dynamic DNS service
syntax:expression: exec "${vyos_libexec_dir}/validate-value --regex \'[A-Za-z0-9][-.A-Za-z0-9]*[A-Za-z0-9]\' --regex \'(\\@|\\*)[-.A-Za-z0-9]*\'   --value \'$VAR(@)\'"; "Host-name must be alphanumeric, can contain hyphens and can be prefixed with '@' or '*'"
