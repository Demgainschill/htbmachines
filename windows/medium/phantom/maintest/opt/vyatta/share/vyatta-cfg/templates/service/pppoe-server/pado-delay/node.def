tag:
type: txt
help: PADO delays
val_help: disable; Disable new connections
val_help: u32:1-999999; Number in ms
allowed: echo "disable"
syntax:expression: exec "${vyos_libexec_dir}/validate-value --regex \'disable\' --exec \"${vyos_validators_dir}/numeric --range 1-999999\"  --value \'$VAR(@)\'"; "Invalid PADO delay"
