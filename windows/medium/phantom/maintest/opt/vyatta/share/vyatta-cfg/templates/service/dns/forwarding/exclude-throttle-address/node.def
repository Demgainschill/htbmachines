multi:
type: txt
help: IP address or subnet
val_help: ipv4; IPv4 address to match
val_help: ipv4net; IPv4 prefix to match
val_help: ipv6; IPv6 address
val_help: ipv6net; IPv6 address
syntax:expression: exec "${vyos_libexec_dir}/validate-value  --exec \"${vyos_validators_dir}/ipv4-address \" --exec \"${vyos_validators_dir}/ipv4-prefix \" --exec \"${vyos_validators_dir}/ipv6-address \" --exec \"${vyos_validators_dir}/ipv6-prefix \"  --value \'$VAR(@)\'"; "Invalid value"
