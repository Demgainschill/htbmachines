type: txt
help: Policy for handling IPv4 directed broadcast forwarding on all
			interfaces (default: enable)
val_help: enable; Enable IPv4 directed broadcast forwarding on all interfaces (default)
val_help: disable; Disable IPv4 directed broadcast forwarding on all interfaces
allowed: echo "enable disable"
syntax:expression: exec "${vyos_libexec_dir}/validate-value --regex \'(enable|disable)\'   --value \'$VAR(@)\'"; "Invalid value"
