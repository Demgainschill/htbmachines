type: txt
help: pre-shared secret key
val_help: txt; pre-shared secret key are required to be at least 16 bytes long, which implies at least 32 characters for hexadecimal key
syntax:expression: exec "${vyos_libexec_dir}/validate-value  --exec \"${vyos_validators_dir}/psk-secret \"  --value \'$VAR(@)\'"; "Invalid value"
