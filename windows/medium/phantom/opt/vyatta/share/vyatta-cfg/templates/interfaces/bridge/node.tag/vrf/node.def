type: txt
help: VRF instance name
val_help: txt; VRF instance name
allowed: /bin/cli-shell-api listNodes vrf name
syntax:expression: exec "${vyos_libexec_dir}/validate-value  --exec \"${vyos_validators_dir}/vrf-name \"  --value \'$VAR(@)\'"; "VRF instance name must be 15 characters or less and can not\nbe named as regular network interfaces.\nA name must starts from a letter.\n"
