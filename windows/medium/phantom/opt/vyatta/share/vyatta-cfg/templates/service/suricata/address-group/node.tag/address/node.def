multi:
type: txt
help: IP address or subnet
val_help: ipv4; IPv4 address to match
val_help: ipv6; IPv6 address to match
val_help: ipv4net; IPv4 prefix to match
val_help: ipv6net; IPv6 prefix to match
val_help: !ipv4; Exclude the specified IPv4 address from matches
val_help: !ipv6; Exclude the specified IPv6 address from matches
val_help: !ipv4net; Exclude the specified IPv6 prefix from matches
val_help: !ipv6net; Exclude the specified IPv6 prefix from matches
syntax:expression: exec "${vyos_libexec_dir}/validate-value  --exec \"${vyos_validators_dir}/ipv4-address \" --exec \"${vyos_validators_dir}/ipv6-address \" --exec \"${vyos_validators_dir}/ipv4-prefix \" --exec \"${vyos_validators_dir}/ipv6-prefix \" --exec \"${vyos_validators_dir}/ipv4-address-exclude \" --exec \"${vyos_validators_dir}/ipv6-address-exclude \" --exec \"${vyos_validators_dir}/ipv4-prefix-exclude \" --exec \"${vyos_validators_dir}/ipv6-prefix-exclude \"  --value \'$VAR(@)\'"; "Invalid value"
