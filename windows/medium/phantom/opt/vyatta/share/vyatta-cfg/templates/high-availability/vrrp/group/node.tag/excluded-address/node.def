tag:
type: txt
help: Virtual address (If you need additional IPv4 and IPv6 in same
			group)
val_help: ipv4net; IPv4 address and prefix length
val_help: ipv6net; IPv6 address and prefix length
val_help: ipv4; IPv4 address
val_help: ipv6; IPv6 address
syntax:expression: exec "${vyos_libexec_dir}/validate-value  --exec \"${vyos_validators_dir}/ip-host \" --exec \"${vyos_validators_dir}/ip-address \"  --value \'$VAR(@)\'"; "Invalid value"
