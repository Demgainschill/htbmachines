type: txt
help: IP address
val_help: ipv4; IPv4 address to match
val_help: ipv6; IPv6 address to match
val_help: hostname; FQDN address to match
syntax:expression: exec "${vyos_libexec_dir}/validate-value  --exec \"${vyos_validators_dir}/ipv4-address \" --exec \"${vyos_validators_dir}/ipv6-address \" --exec \"${vyos_validators_dir}/fqdn \"  --value \'$VAR(@)\'"; "Invalid value"
