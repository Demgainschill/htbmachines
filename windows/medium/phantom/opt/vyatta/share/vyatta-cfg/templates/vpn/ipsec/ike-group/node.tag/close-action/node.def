type: txt
help: Action to take if a child SA is unexpectedly closed (default:
			none)
val_help: none; Do nothing (default)
val_help: trap; Attempt to re-negotiate when matching traffic is seen
val_help: start; Attempt to re-negotiate the connection immediately
allowed: echo "none trap start"
syntax:expression: exec "${vyos_libexec_dir}/validate-value --regex \'(none|trap|start)\'   --value \'$VAR(@)\'"; "Invalid value"
