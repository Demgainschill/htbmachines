type: txt
help: Security mode for RADIUS authentication (default: optional)
val_help: mandatory; Deny access immediately if RADIUS answers with Access-Reject
val_help: optional; Pass to the next authentication method if RADIUS answers with Access-Reject (default)
allowed: echo "mandatory optional"
syntax:expression: exec "${vyos_libexec_dir}/validate-value --regex \'(mandatory|optional)\'   --value \'$VAR(@)\'"; "Invalid value"
