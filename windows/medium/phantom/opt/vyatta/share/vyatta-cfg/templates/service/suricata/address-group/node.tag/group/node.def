multi:
type: txt
help: Address group
val_help: txt; Address group to match
val_help: !txt; Exclude the specified address group from matches
allowed: /bin/cli-shell-api listNodes service ids suricata address-group
syntax:expression: exec "${vyos_libexec_dir}/validate-value --regex \'!?[a-z0-9-]+\'   --value \'$VAR(@)\'"; "Invalid value"
