help: Bring connection-oriented network interface down and up
allowed: /bin/cli-shell-api listActiveNodes interfaces pppoe | sed -e "s/'//g" && echo && /bin/cli-shell-api listActiveNodes interfaces sstpc | sed -e "s/'//g" && echo && /bin/cli-shell-api listActiveNodes interfaces wwan | sed -e "s/'//g" && echo
run: sudo ${vyos_op_scripts_dir}/connect_disconnect.py --connect --disconnect --interface "$3"
